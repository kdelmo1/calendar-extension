{
  "manifest_version": 3,
  "name": "Dates to Google Calendar",
  "version": "0.1.0",
  "description": "Review dates in a side panel before adding them to a separate Google Calendar.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open dates panel"
  },
  "side_panel": {
    "default_path": "extension/sidepanel/index.html"
  },
  "key": ""
}
