{
  "name": "calendar-proxy",
  "version": "0.1.0",
  "private": true,
  "description": "Small server that calls Gemini so the API key never goes in the extension (Lane 2)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "try:ucsc": "tsx scripts/try-ucsc.ts",
    "try:files": "tsx scripts/try-files.ts",
    "try:prompt": "tsx scripts/try-prompt.ts",
    "try:errors": "tsx scripts/try-errors.ts",
    "try:real": "tsx scripts/try-real.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.3.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "typescript": "^7.0.2"
  }
}
